# Database
DATABASE_PASSWORD=your_secure_password_here
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=rankwrangler
DATABASE_USER=rankwrangler

# Amazon SP-API Configuration
SPAPI_REFRESH_TOKEN=your_spapi_refresh_token_here
SPAPI_CLIENT_ID=your_spapi_client_id_here
SPAPI_APP_CLIENT_SECRET=your_spapi_app_client_secret_here

# Clerk + centralized Merchbase access (REQUIRED)
CLERK_SECRET_KEY=your_clerk_secret_key_here
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_JWT_KEY=your_clerk_jwt_key_here
CLERK_ISSUER=https://clerk.yourdomain.com
CLERK_AUTHORIZED_PARTIES=https://app.yourdomain.com,chrome-extension://your-extension-id
CLERK_WEBHOOK_SIGNING_SECRET=your_clerk_webhook_signing_secret_here
CLERK_OAUTH_AUDIENCE=https://api.yourdomain.com
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
VITE_CLERK_SYNC_HOST=https://clerk.merchbase.co
VITE_EXTENSION_AUTH_MODE=chrome
VITE_SAFARI_NATIVE_APPLICATION_ID=merchbase.rankwrangler
VITE_CLERK_OAUTH_AUTHORIZATION_URL=https://clerk.merchbase.co/oauth/authorize
VITE_CLERK_OAUTH_TOKEN_URL=https://clerk.merchbase.co/oauth/token
VITE_CLERK_OAUTH_CLIENT_ID=your_public_safari_oauth_client_id_here
VITE_CLERK_OAUTH_REDIRECT_URI=rankwrangler://oauth/callback
VITE_CLERK_OAUTH_SCOPES=openid email profile
VITE_CLERK_OAUTH_AUDIENCE=https://api.yourdomain.com
DEV_CLERK_SIGN_IN_USER_ID=your_clerk_dev_user_id_here
VITE_DEV_CLERK_AUTO_SIGN_IN=false
DISABLE_SERVER_JOB_RUNNER=false

# Admin Configuration (OPTIONAL - if not set, admin APIs are disabled)
ADMIN_MERCHBASE_USER_ID=mbu_admin_user_here

# Optional services
KEEPA_API_KEY=your_keepa_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Website (OPTIONAL)
VITE_API_URL=http://localhost:8080
WEBSITE_API_PROXY_TARGET=http://localhost:8080

# CLI (OPTIONAL - for local CLI testing)
MERCHBASE_API_KEY=your_merchbase_api_key_here
RR_API_URL=http://localhost:8080
RR_MARKETPLACE_ID=ATVPDKIKX0DER
RR_STORAGE_DIR=

# Notes:
# - Copy this file to .env in the repo root and fill in your values
# - `bun run server:dev` and `bun run dev` default `DISABLE_SERVER_JOB_RUNNER=true`
# - Use `bun run server:dev:jobs` or `bun run dev:jobs` to opt into local job workers
# - Escape $ characters as $$ in docker-compose (e.g., password hashes)
# - Postgres host port is 5433
