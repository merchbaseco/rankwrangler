# RankWrangler Stack Internal Caddy Configuration
# This handles routing within the stack (nginx replacement)

{
    # Disable admin API for security in production
    admin off
    
    # Enable JSON logging
    log {
        output stdout
        format filter {
            wrap json
            fields {
                request>headers>Cf-Access-Client-Secret delete
                request>headers>Cf-Access-Jwt-Assertion delete
            }
        }
    }
    
    # Auto HTTPS off (SSL handled at server level)
    auto_https off
}

# Listen on port 80 (internal to stack)
:80 {
    # Enable access logs
    log {
        output stdout
        format filter {
            wrap json
            fields {
                request>headers>Cf-Access-Client-Secret delete
                request>headers>Cf-Access-Jwt-Assertion delete
            }
        }
    }
    
    @internalDenied {
        host rankwrangler-internal.merchbase.co
        not path /api/api.public.product.getMany /api/internal/access-snapshot
    }
    handle @internalDenied {
        respond 404
    }

    @safariCallback path /oauth/safari/callback
    handle @safariCallback {
        log_skip
        header Cache-Control no-store
        header Referrer-Policy no-referrer
        respond "Return to RankWrangler Safari." 200
    }
    handle /.well-known/apple-app-site-association {
        root * /srv
        header Content-Type application/json
        file_server
    }

    # API routes to RankWrangler server
    handle /api/* {
        reverse_proxy server:8080 {
            # Health checks
            health_uri /health/live
            health_interval 30s
            health_timeout 10s
            
            # Load balancing (single backend, but good for monitoring)
            fail_duration 30s
            max_fails 3
            
            # Forward headers for proper client info
            header_up Host {http.request.host}
            header_up X-Real-IP {http.request.remote}
            header_up X-Forwarded-For {http.request.remote}
            header_up X-Forwarded-Proto {http.request.scheme}
            header_up X-Forwarded-Host {http.request.host}
        }
    }

    # Hosted MCP and OAuth discovery routes to the Fastify MCP handler.
    # Keep this list exact; all other paths belong to the website SPA below.
    @mcp path /mcp /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/mcp
    handle @mcp {
        reverse_proxy server:8080 {
            header_up Host {http.request.host}
            header_up X-Real-IP {http.request.remote}
            header_up X-Forwarded-For {http.request.remote}
            header_up X-Forwarded-Proto {http.request.scheme}
            header_up X-Forwarded-Host {http.request.host}
        }
    }
    
    # Nginx health check endpoint for monitoring
    handle /nginx-health {
        respond "healthy" 200
    }
    
    # Caddy health check endpoint
    handle /caddy-health {
        header Content-Type application/json
        respond `{"status":"ok","service":"rankwrangler-caddy"}` 200
    }

    handle /health/live {
        reverse_proxy server:8080 {
            header_up Host {http.request.host}
            header_up X-Real-IP {http.request.remote}
            header_up X-Forwarded-For {http.request.remote}
            header_up X-Forwarded-Proto {http.request.scheme}
            header_up X-Forwarded-Host {http.request.host}
        }
    }

    @apiOnlyHost host rankwrangler-api.merchbase.co rankwrangler-internal.merchbase.co
    handle @apiOnlyHost {
        respond "Not found" 404
    }

    # Website (SPA) for all non-API routes
    #
    # Served from /srv, which is baked into the caddy image at build time.
    handle * {
        root * /srv
        encode zstd gzip
        try_files {path} /index.html
        file_server
    }
}
