# syntax=docker/dockerfile:1.6

# Build the RankWrangler website (Vite -> static assets)
FROM oven/bun:1.3.5 AS webbuild
WORKDIR /repo

# Vite inlines VITE_-prefixed values into the bundle at build time. No env
# file is copied into the image; every value arrives as a build argument from
# compose, which gets it from `varlock run`. Each ARG must match a compose
# build arg — an undeclared ARG is silently dropped, so `bun run env:contract`
# checks both halves. Only @public schema items may appear here: everything
# below ships inside a browser bundle.
ARG VITE_RANKWRANGLER_API_URL
ARG VITE_RANKWRANGLER_APP_VERSION
ARG VITE_RANKWRANGLER_DEV_CLERK_AUTO_SIGN_IN
ARG VITE_MERCHBASE_CLERK_PUBLISHABLE_KEY
ARG VITE_MERCHBASE_CLERK_SYNC_HOST
ENV VITE_RANKWRANGLER_API_URL=${VITE_RANKWRANGLER_API_URL}
ENV VITE_RANKWRANGLER_APP_VERSION=${VITE_RANKWRANGLER_APP_VERSION}
ENV VITE_RANKWRANGLER_DEV_CLERK_AUTO_SIGN_IN=${VITE_RANKWRANGLER_DEV_CLERK_AUTO_SIGN_IN}
ENV VITE_MERCHBASE_CLERK_PUBLISHABLE_KEY=${VITE_MERCHBASE_CLERK_PUBLISHABLE_KEY}
ENV VITE_MERCHBASE_CLERK_SYNC_HOST=${VITE_MERCHBASE_CLERK_SYNC_HOST}

COPY package.json bun.lock .npmrc ./
#
# Bun workspaces: include referenced workspace manifests so `bun install` can resolve.
#
COPY packages/http-client/package.json packages/http-client/package.json
COPY packages/history-chart/package.json packages/history-chart/package.json
COPY packages/cli/package.json packages/cli/package.json
COPY apps ./apps

RUN --mount=type=secret,id=github_packages_token,required=true \
    MERCHBASE_GITHUB_NPM_TOKEN="$(cat /run/secrets/github_packages_token)" \
    bun install --frozen-lockfile --ignore-scripts
COPY packages/history-chart ./packages/history-chart
RUN bun run --filter @rankwrangler/website build

# Runtime: Caddy serves static website + proxies /api/* to the server container
FROM caddy:alpine

COPY apps/server/Caddyfile /etc/caddy/Caddyfile
COPY --from=webbuild /repo/apps/website/dist /srv
