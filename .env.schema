# The plugin version is pinned so the schema resolves through `bunx varlock`
# before node_modules exists (cloud-agent and fresh-clone installs).
# @plugin(@varlock/1password-plugin@2.0.3)
# @initOp(id=development, token=fallback($CLOUD_AGENTS_DEVELOPMENT_OP_TOKEN, $CI_OP_TOKEN), allowAppAuth=forEnv(development), account=knickerbockerventures.1password.com)
# @initOp(id=production, token=$DEPLOY_AGENT_PRODUCTION_OP_TOKEN, allowAppAuth=false)
# @initOp(id=release, token=$RELEASE_AGENT_TOOLING_OP_TOKEN, allowAppAuth=forEnv(development), account=knickerbockerventures.1password.com)
# @currentEnv=$VARLOCK_ENV
# Lifecycles: production and development resolve through 1Password; test
# resolves to fake-but-shaped literals only, so schema validation and the Bun
# test suites run fully offline with no 1Password access. Every lifecycle
# resolves deliberately — add a test arm whenever you add a variable.
# Sensitivity fails safe: an item without an explicit marker resolves as
# sensitive, so a forgotten decorator becomes a container secret rather than a
# plaintext value baked into a website bundle. Public values must opt out
# explicitly.
# @defaultSensitive=true @defaultRequired=infer
# ---

# Varlock's selector. The enum is the fail-loud guard: any other value —
# including lifecycles varlock can infer in CI, like preview — is rejected at
# load instead of silently riding each value's development arm.
# @public @auditIgnore @type=enum(development, production, test)
VARLOCK_ENV=development


# --- Bootstrap identities ------------------------------------------------
# One per unattended consumer; the name encodes the consumer and lifecycle it
# serves. Supervised local work uses 1Password desktop-app authorization
# instead. Both are @internal, so `varlock run` never exports them into the
# server container or a website build.

# Production deploy-agent role slot: each deploy venue supplies its own
# identity under this one name — the self-hosted GitHub Actions runner injects
# the GitHub deploy agent's token (GH_DEPLOY_AGENT_PRODUCTION_OP_TOKEN secret),
# and an operator run resolves the Mac Mini identity through `op run` in the
# deploy script.
# @type=opServiceAccountToken @sensitive @internal @auditIgnore
# @required=forEnv(production)
DEPLOY_AGENT_PRODUCTION_OP_TOKEN=

# Shared fleet cloud-agent development identity, read-only on the Development
# vault, provided by every cloud agent platform (Claude and Cursor). Supervised
# local development leaves this empty and uses desktop-app authorization. Only
# cloud agent platforms fill this slot.
# @type=opServiceAccountToken @sensitive @internal @auditIgnore
# @optional
CLOUD_AGENTS_DEVELOPMENT_OP_TOKEN=

# CI bootstrap role slot. GitHub Actions supplies the fleet deploy identity
# here so licensed install tokens (Hugeicons Pro, HeroUI Pro) resolve from the
# Development vault; no per-token repository secrets exist.
# @type=opServiceAccountToken @sensitive @internal @auditIgnore
# @optional
CI_OP_TOKEN=

# Release-agent role slot, read-only on the Tooling vault. The Deploy Stack
# publish job injects GH_RELEASE_AGENT_TOOLING_OP_TOKEN. A local release leaves
# this empty and uses desktop-app authorization on the release client.
# @type=opServiceAccountToken @sensitive @internal @auditIgnore
# @optional
RELEASE_AGENT_TOOLING_OP_TOKEN=


# --- Context switches ----------------------------------------------------
# Machinery credentials resolve ONLY behind these switches. Build, dev-server,
# test, and ordinary production resolution therefore never contact 1Password —
# which matters because Vite and the Docker build re-resolve the whole schema
# in contexts that cannot authenticate.

# Set to true by the install script when fetching install tokens with
# `varlock printenv`.
# @public @internal @auditIgnore @type=boolean
RANKWRANGLER_RESOLVE_INSTALL_TOKENS=false

# Set to true by the npm release flow when fetching the publish token. Release
# is a third context, distinct from install and deploy: it targets the Tooling
# lifecycle vault.
# @public @internal @auditIgnore @type=boolean
RANKWRANGLER_RESOLVE_RELEASE_TOKENS=false


# --- Machinery credentials -----------------------------------------------

# Installing the private @merchbaseco/* packages. Shared suite credential: the
# name identifies the issuing owner, not this repo, and it resolves from the
# existing shared item rather than a per-repo copy. Referenced literally by
# .npmrc. CI and the deploy runner inject their own platform copy (the
# workflow's repository-scoped github.token), which wins as process env.
# @sensitive @internal @auditIgnore @optional
MERCHBASE_GITHUB_NPM_TOKEN=if(eq($RANKWRANGLER_RESOLVE_INSTALL_TOKENS, true), op(development, "op://Development/GitHub Packages Read - Merchbase/credential"), "")

# Installing the licensed @hugeicons-pro/* packages. Shared suite credential,
# resolved from the same item Haus uses. Referenced literally by bunfig.toml's
# `[install.scopes]` token. CI injects its own copy from a repository secret,
# which wins as process env.
# @sensitive @internal @auditIgnore @optional
MERCHBASE_HUGEICONS_LICENSE_KEY=if(eq($RANKWRANGLER_RESOLVE_INSTALL_TOKENS, true), op(development, "op://Development/HugeIcons Pro - Merchbase/credential"), "")

# Licensed HeroUI Pro dist downloads. `scripts/setup-heroui.mjs` bridges this
# canonical name onto the vendor installer's literal HEROUI_AUTH_TOKEN. Shared
# suite credential, resolved from the same item Haus uses.
# @sensitive @internal @auditIgnore @optional
HEROUI_PRO_CICD_TOKEN=if(eq($RANKWRANGLER_RESOLVE_INSTALL_TOKENS, true), op(development, "op://Development/HeroUI Pro CICD - Merchbase/credential"), "")

# Publishing to the public npm registry. Shared suite credential: the name
# identifies the issuing owner, not this repo, and it resolves from the shared
# item rather than a per-repo copy. Distinct from the suite's GitHub Packages
# publishing credential — different registry, separately rotated. Referenced
# literally by .npmrc, and gated by this repo's own release switch because only
# a RankWrangler release run needs it.
# @sensitive @internal @auditIgnore @optional
MERCHBASE_NPM_PUBLISH_TOKEN=if(eq($RANKWRANGLER_RESOLVE_RELEASE_TOKENS, true), op(release, "op://Tooling/NPM Publish - Merchbase/credential"), "")


# Cloudflare Access validates each route against a separate application.
# @type=url @public
MERCHBASE_ACCESS_ISSUER=if(eq($VARLOCK_ENV, test), https://example.cloudflareaccess.com, if(eq($VARLOCK_ENV, production), op(production, "op://Production/Cloudflare Access - Merchbase/issuer"), op(development, "op://Development/Cloudflare Access - Merchbase/issuer")))

# @type=url @public
MERCHBASE_ACCESS_AUTHORITY_ORIGIN=https://access-internal.merchbase.co

# @public
MERCHBASE_ACCESS_API_AUDIENCE=if(eq($VARLOCK_ENV, test), offline-merchbase_access_api_audience, if(eq($VARLOCK_ENV, production), op(production, "op://Production/Cloudflare Access - Merchbase/API audience"), op(development, "op://Development/Cloudflare Access - Merchbase/API audience")))

# @public
MERCHBASE_ACCESS_INTERACTIVE_AUDIENCE=if(eq($VARLOCK_ENV, test), offline-merchbase_access_rankwrangler_interactive_audience, if(eq($VARLOCK_ENV, production), op(production, "op://Production/Cloudflare Access - Merchbase/interactive audience"), op(development, "op://Development/Cloudflare Access - Merchbase/interactive audience")))

# @public
MERCHBASE_ACCESS_RANKWRANGLER_INTERNAL_AUDIENCE=if(eq($VARLOCK_ENV, test), offline-merchbase_access_rankwrangler_internal_audience, if(eq($VARLOCK_ENV, production), op(production, "op://Production/Cloudflare Access - Merchbase/RankWrangler internal audience"), op(development, "op://Development/Cloudflare Access - Merchbase/RankWrangler internal audience")))

# @public
MERCHBASE_ACCESS_RANKWRANGLER_CLIENT_ID=if(eq($VARLOCK_ENV, test), offline-merchbase_access_rankwrangler_client_id, if(eq($VARLOCK_ENV, production), op(production, "op://Production/Cloudflare Service - RankWrangler/client id"), op(development, "op://Development/Cloudflare Service - RankWrangler/client id")))

# @sensitive
MERCHBASE_ACCESS_RANKWRANGLER_CLIENT_SECRET=if(eq($VARLOCK_ENV, test), offline-merchbase_access_rankwrangler_client_secret, if(eq($VARLOCK_ENV, production), op(production, "op://Production/Cloudflare Service - RankWrangler/client secret"), op(development, "op://Development/Cloudflare Service - RankWrangler/client secret")))

# @public
MERCHBASE_ACCESS_AUTHORITY_CLIENT_ID=if(eq($VARLOCK_ENV, test), offline-merchbase_access_authority_client_id, if(eq($VARLOCK_ENV, production), op(production, "op://Production/Cloudflare Service - Merchbase Access/client id"), op(development, "op://Development/Cloudflare Service - Merchbase Access/client id")))

# Only BidBeacon may delegate the bounded internal product lookup.
# @public @optional
MERCHBASE_ACCESS_BIDBEACON_CLIENT_ID=if(eq($VARLOCK_ENV, test), offline-bidbeacon-client, if(eq($VARLOCK_ENV, production), op(production, "op://Production/Cloudflare Service - BidBeacon/client id"), ""))

# --- Server runtime configuration ----------------------------------------

# @public @type=port
RANKWRANGLER_PORT=8080

# Production uses PlanetScale; development targets local PostgreSQL on loopback.
# @public
RANKWRANGLER_DATABASE_HOST=if(eq($VARLOCK_ENV, production), us-east-3.pg.psdb.cloud, 127.0.0.1)

# @public @type=port
RANKWRANGLER_DATABASE_PORT=if(eq($VARLOCK_ENV, production), 6432, 5433)

# Optional direct endpoint for migrations and pg-boss. PlanetScale uses 5432
# here and 6432 for application queries. Empty reuses DATABASE_PORT.
# @public @optional @type=port
RANKWRANGLER_DATABASE_DIRECT_PORT=if(eq($VARLOCK_ENV, production), 5432, undefined)

# Remote PlanetScale connections require verified TLS. Local PostgreSQL does
# not serve TLS. Change this with the target connection settings at cutover.
# @public @type=enum(disable, verify-full)
RANKWRANGLER_DATABASE_SSL_MODE=if(eq($VARLOCK_ENV, production), verify-full, disable)

# @public
RANKWRANGLER_DATABASE_NAME=if(eq($VARLOCK_ENV, production), postgres, rankwrangler)

# @public
RANKWRANGLER_DATABASE_USER=if(eq($VARLOCK_ENV, production), op(production, "op://Production/PlanetScale - RankWrangler/username"), rankwrangler)

# @sensitive @required
RANKWRANGLER_DATABASE_PASSWORD=if(eq($VARLOCK_ENV, test), rankwrangler, if(eq($VARLOCK_ENV, production), op(production, "op://Production/PlanetScale - RankWrangler/password"), op(development, "op://Development/Postgres - RankWrangler/password")))

# Guards the central-auth cutover migration. `pre-cutover` applies through the
# additive migration 0027 and leaves running containers untouched; `latest`
# requires the guarded migration 0028 to be already applied. Production
# completed the cutover and sits at `latest`.
# @public @type=enum(pre-cutover, latest)
RANKWRANGLER_DATABASE_MIGRATION_TARGET=latest

# Local server scripts disable the background job runner by default; use the
# *:jobs commands to opt in.
# @public @type=boolean
RANKWRANGLER_DISABLE_SERVER_JOB_RUNNER=if(eq($VARLOCK_ENV, production), false, true)

# Enables the admin tRPC surface for exactly one Merchbase user. Unset disables
# the admin APIs entirely.
# @sensitive @optional
RANKWRANGLER_ADMIN_MERCHBASE_USER_ID=if(eq($VARLOCK_ENV, test), mbu_test_admin, if(eq($VARLOCK_ENV, production), op(production, "op://Production/Admin User - RankWrangler/username"), undefined))


# --- Provider credentials (RankWrangler-owned) ---------------------------

# Product photo cutouts use a dedicated public R2 bucket. Atlas uses a separate
# private bucket and bucket-scoped credential in the same Cloudflare account.
# @public
RANKWRANGLER_R2_ACCOUNT_ID=724dcbc66c598aceef727137229485f3
# @public
RANKWRANGLER_R2_BUCKET_NAME=rankwrangler-thumbnails
# @public @type=url
RANKWRANGLER_CUTOUT_TRANSFORM_ORIGIN=https://rankwrangler.merchbase.co
# @public @type=url
RANKWRANGLER_CUTOUT_PUBLIC_ORIGIN=https://images.rankwrangler.merchbase.co
# @sensitive @optional
RANKWRANGLER_R2_ACCESS_KEY_ID=if(eq($VARLOCK_ENV, production), op(production, "op://Production/Cloudflare R2 - RankWrangler/username"), "")
# @sensitive @optional
RANKWRANGLER_R2_SECRET_ACCESS_KEY=if(eq($VARLOCK_ENV, production), op(production, "op://Production/Cloudflare R2 - RankWrangler/credential"), "")

# @sensitive @optional
RANKWRANGLER_KEEPA_API_KEY=if(eq($VARLOCK_ENV, test), keepa-test-key, if(eq($VARLOCK_ENV, production), op(production, "op://Production/Keepa API - RankWrangler/credential"), op(development, "op://Development/Keepa API - RankWrangler/credential")))

# @sensitive @optional
RANKWRANGLER_GEMINI_API_KEY=if(eq($VARLOCK_ENV, test), gemini-test-key, if(eq($VARLOCK_ENV, production), op(production, "op://Production/Google AI Studio - RankWrangler/credential"), op(development, "op://Development/Google AI Studio - RankWrangler/credential")))

# @sensitive @optional
RANKWRANGLER_TYPESAFE_API_KEY=if(eq($VARLOCK_ENV, test), typesafe-test-key, if(eq($VARLOCK_ENV, production), op(production, "op://Production/TypeSafe AI - Merchbase/credential"), op(development, "op://Development/TypeSafe AI - Merchbase/credential")))

# Amazon SP-API application credentials.
# @sensitive @required
RANKWRANGLER_SPAPI_REFRESH_TOKEN=if(eq($VARLOCK_ENV, test), test, if(eq($VARLOCK_ENV, production), op(production, "op://Production/Amazon SP-API - RankWrangler/refresh token"), op(development, "op://Development/Amazon SP-API - RankWrangler/refresh token")))

# @sensitive @required
RANKWRANGLER_SPAPI_CLIENT_ID=if(eq($VARLOCK_ENV, test), test, if(eq($VARLOCK_ENV, production), op(production, "op://Production/Amazon SP-API - RankWrangler/username"), op(development, "op://Development/Amazon SP-API - RankWrangler/username")))

# @sensitive @required
RANKWRANGLER_SPAPI_APP_CLIENT_SECRET=if(eq($VARLOCK_ENV, test), test, if(eq($VARLOCK_ENV, production), op(production, "op://Production/Amazon SP-API - RankWrangler/credential"), op(development, "op://Development/Amazon SP-API - RankWrangler/credential")))


# --- Website and extension build inputs ----------------------------------
# External literal-prefix exemption: Vite only exposes variables whose name
# begins with VITE_, so the prefix is a platform requirement. The owner prefix
# follows it, keeping one canonical owner per value. Everything here is inlined
# into a public browser bundle at build time and must therefore be @public —
# never place a secret behind a VITE_ name.

# Same-origin /api when empty; set only for a split-origin preview.
# @public @optional
VITE_RANKWRANGLER_API_URL=

# Falls back to the server package version when empty.
# @public @optional
VITE_RANKWRANGLER_APP_VERSION=

# @public @type=enum(chrome, safari)
VITE_RANKWRANGLER_EXTENSION_AUTH_MODE=chrome

# @public
VITE_RANKWRANGLER_SAFARI_NATIVE_APPLICATION_ID=merchbase.rankwrangler

# Safari native OAuth discovers Cloudflare endpoints and registers a public
# PKCE client. These values never contain a secret.
# @public @type=url
VITE_MERCHBASE_ACCESS_ISSUER=https://thearcade.cloudflareaccess.com

# @public @type=url
VITE_RANKWRANGLER_SAFARI_OAUTH_RESOURCE=https://rankwrangler-api.merchbase.co/

# @public @type=url
VITE_RANKWRANGLER_SAFARI_OAUTH_REDIRECT_URI=https://rankwrangler.merchbase.co/oauth/safari/callback

# Vite dev-server proxy target for /api. Development only.
# @public @type=url
RANKWRANGLER_WEBSITE_API_PROXY_TARGET=http://localhost:8080

# Dev server bind address, and a dev-only concern: `apps/website/vite.config.ts`
# is the only reader and nothing in the server runtime consults it. Loopback
# keeps a dev server — and the synthetic seed data behind it — off the network.
# An environment that reaches the server through a port forwarder sets 0.0.0.0
# for its own dev command, because such forwarders find a session's ports by
# watching for listening sockets and a loopback-only bind is invisible to them.
# Only the socket widens: the origin the app believes it serves is unchanged.
# @public @auditIgnore @type=ip
RANKWRANGLER_DEV_HOST=127.0.0.1
