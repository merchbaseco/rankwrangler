{
    "name": "@rankwrangler/http-client",
    "version": "0.8.0",
    "description": "Typed tRPC client for RankWrangler",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "test": "tsc -p tsconfig.test.json && bun test test/*.test.ts"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "sideEffects": false,
    "dependencies": {
        "@trpc/client": "11.10.0",
        "@trpc/server": "11.10.0"
    },
    "packageManager": "bun@1.1.27"
}
