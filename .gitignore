# Dependencies
node_modules/

# Build output
dist/

# Environment variables
.env
.env.local
.env.development
.env.test
.env.production

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Local analysis artifacts
apps/server/tmp/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker artifacts
stack.env

# Varlock schema is the committed contract
!.env.schema

# Cursor links fleet skills into .agents/skills; the cloud agent scripts stay tracked.
.agents/*
!.agents/cloud/

# Claude Code keeps per-checkout state here (worktrees, local settings). The
# shared slash commands and the cloud SessionStart hook are the committed
# parts, so name them back in rather than ignoring the directory itself — git
# will not look inside an ignored directory to find them.
.claude/*
!.claude/commands/
!.claude/settings.json

# Design skill renders (render.sh output)
.design/renders/
